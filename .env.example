# HydraGuard environment template. Copy to .env and replace every value.
# Never commit real tokens. .env and .env.* are git-ignored; this file is not.

# --- HydraDB ---
HYDRADB_URI=bolt://127.0.0.1:7687
HYDRADB_USER=neo4j
HYDRADB_TOKEN=replace-with-local-development-token
HYDRADB_DATABASE=default

# --- API ---
API_PORT=3000

# Browser origins allowed to call the local API. Keep production values to your
# deployed console URL(s), never use a wildcard.
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Analyst authorization for typosquatting finding review ---
# Required in production: startup fails if unset. 16-512 chars, no whitespace.
# Development and test fall back to "local-development-analyst-token".
TYPOSQUATTING_ANALYST_BEARER_TOKEN=replace-with-local-development-analyst-token

# Trusted reviewer identity written to every analyst-review Evidence node.
# Max 200 characters, no leading or trailing whitespace.
TYPOSQUATTING_ANALYST_PRINCIPAL=local-dashboard-analyst

# --- Dashboard (place in dashboard/.env) ---
# Must match TYPOSQUATTING_ANALYST_BEARER_TOKEN. Vite inlines this into the
# public bundle at build time, so treat it as publicly readable.
VITE_TYPOSQUATTING_ANALYST_TOKEN=replace-with-local-development-analyst-token

{
  "name": "@hydraguard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:analysis": "tsx src/analysis/fixtures/analysis-smoke.ts",
    "validate:wave2": "tsx src/analysis/fixtures/wave2-smoke.ts",
    "validate:containment": "tsx src/analysis/fixtures/containment-smoke.ts",
    "validate:release-firewall": "tsx src/analysis/fixtures/release-influence-smoke.ts",
    "validate:release-persistence": "tsx src/analysis/fixtures/release-persistence-smoke.ts",
    "test:seed": "npx tsx src/seed-test.ts",
    "validate:fixture": "tsx src/domain/fixture.ts",
    "validate:lockfile": "tsx src/ingest/lockfile/lockfile-smoke.ts",
    "validate:graph-batch": "tsx src/ingest/graph-batch-smoke.ts",
    "validate:orchestrator": "tsx src/ingest/npm/orchestrator-smoke.ts",
    "validate:persistence": "tsx src/db/persistence-smoke.ts",
    "demo:preload": "tsx src/demo/preload.ts",
    "validate:persistence-service": "tsx src/db/persistence-service-smoke.ts",
    "validate:job-manager": "tsx src/api/jobs/job-manager-smoke.ts",
    "validate:worker-dispatcher": "tsx src/api/jobs/worker-dispatcher-smoke.ts",
    "start": "tsx src/api/index.ts",
    "validate:live-analysis": "tsx src/analysis/fixtures/live-analysis-smoke.ts",
    "validate:server": "tsx src/api/server-smoke.ts",
    "validate:e2e": "tsx src/demo/e2e-smoke.ts",
    "validate:all": "npm run typecheck && npm run validate:fixture && npm run validate:lockfile && npm run validate:graph-batch && npm run validate:orchestrator && npm run validate:persistence && npm run validate:persistence-service && npm run validate:job-manager && npm run validate:worker-dispatcher && npm run validate:analysis && npm run validate:wave2 && npm run validate:containment && npm run validate:release-firewall && npm run validate:release-persistence && npm run validate:live-analysis && npm run validate:server"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "fastify": "5.12.0",
    "neo4j-driver": "6.2.0",
    "semver": "7.7.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/semver": "7.7.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
